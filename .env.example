# Zettle API key credentials (my.zettle.com → Integrations → API keys)
ZETTLE_CLIENT_ID=
ZETTLE_API_KEY=

# Library product whose variants are the committees ("fra - Alumniskatt")
ALUMNISKATT_PRODUCT_UUID=3e72739a-4b03-11f1-b402-4bcd778be7fe

# Only purchases in this window count (ISO 8601). EVENT_START defaults to midnight today.
EVENT_START=2026-10-19T00:00:00
EVENT_END=2026-10-20T00:00:00

# Optional
# POLL_INTERVAL_S=60
# PORT=3000
